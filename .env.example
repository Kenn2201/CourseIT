# CourseIT Environment Configuration Template
# Copy this file to .env and configure your secrets

# Server-only AI generation. Gemini is primary; configured fallbacks run on
# transient provider failures in this order: Gemini -> Cerebras -> Groq -> Mistral -> OpenRouter.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (check your provider account's available models)
CEREBRAS_MODEL=llama3.1-8b
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=openrouter/free

# Appwrite Client Configuration (Exposed to browser via VITE_)
VITE_APPWRITE_ENDPOINT=https://syd.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id
VITE_APPWRITE_COLLECTION_ID=courses

# Appwrite Server Configuration (Used by dev middleware & backend handlers)
APPWRITE_ENDPOINT=https://syd.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_DATABASE_ID=your_appwrite_database_id
APPWRITE_COLLECTION_ID=courses
APPWRITE_API_KEY=your_appwrite_server_api_key
# Optional separate server-only key with users.read scope for Admin Auth overview
APPWRITE_USERS_API_KEY=your_appwrite_users_read_api_key

# Resend Email Delivery Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=CourseIT <hello@courseit.kenncode.me>

# Platform Administrator Email
ADMIN_EMAIL=your_admin_email@example.com
VITE_ADMIN_EMAIL=your_admin_email@example.com

# Optional Sentry error monitoring (DSN is a public project identifier, not an auth token)
VITE_SENTRY_DSN=
SENTRY_DSN=
