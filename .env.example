# CourseIT Environment Variables

# LLM Configuration (Google Gemini, OpenAI, etc.)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here

# Appwrite Client Configuration (Accessible from browser via VITE_)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id
VITE_APPWRITE_COLLECTION_ID=6aaa6fef000b2b0129c4

# Appwrite Server Configuration (Used by serverless function / dev server for write operations)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_DATABASE_ID=your_appwrite_database_id
APPWRITE_COLLECTION_ID=6aaa6fef000b2b0129c4
APPWRITE_API_KEY=your_appwrite_server_api_key_with_database_write_permission
