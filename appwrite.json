{
  "projectId": "YOUR_APPWRITE_PROJECT_ID",
  "projectName": "courseit",
  "databases": [
    {
      "$id": "YOUR_APPWRITE_DATABASE_ID",
      "name": "courseit",
      "enabled": true
    }
  ],
  "collections": [
    {
      "$id": "YOUR_APPWRITE_COLLECTION_ID",
      "$permissions": [
        "read(\"any\")"
      ],
      "databaseId": "YOUR_APPWRITE_DATABASE_ID",
      "name": "courses",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        {
          "key": "source_url",
          "type": "url",
          "status": "available",
          "required": true,
          "array": false
        },
        {
          "key": "title",
          "type": "string",
          "status": "available",
          "required": true,
          "array": false,
          "size": 255
        },
        {
          "key": "steps",
          "type": "string",
          "status": "available",
          "required": true,
          "array": false,
          "size": 1000000
        }
      ],
      "indexes": []
    },
    {
      "$id": "users_quota",
      "$permissions": [
        "read(\"any\")",
        "create(\"any\")",
        "update(\"any\")"
      ],
      "databaseId": "YOUR_APPWRITE_DATABASE_ID",
      "name": "users_quota",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        {
          "key": "user_id",
          "type": "string",
          "status": "available",
          "required": true,
          "array": false,
          "size": 255
        },
        {
          "key": "name",
          "type": "string",
          "status": "available",
          "required": true,
          "array": false,
          "size": 255
        },
        {
          "key": "email",
          "type": "string",
          "status": "available",
          "required": true,
          "array": false,
          "size": 255
        },
        {
          "key": "quota_remaining",
          "type": "integer",
          "status": "available",
          "required": false,
          "array": false,
          "min": 0,
          "max": 10000,
          "default": 50
        },
        {
          "key": "status",
          "type": "string",
          "status": "available",
          "required": false,
          "array": false,
          "size": 50,
          "default": "pending"
        }
      ],
      "indexes": [
        {
          "key": "idx_user_id",
          "type": "key",
          "status": "available",
          "attributes": ["user_id"],
          "orders": ["ASC"]
        },
        {
          "key": "idx_email",
          "type": "key",
          "status": "available",
          "attributes": ["email"],
          "orders": ["ASC"]
        }
      ]
    }
  ],
  "buckets": [
    {
      "$id": "course_docs",
      "name": "course_docs",
      "$permissions": [
        "read(\"any\")",
        "create(\"any\")",
        "update(\"any\")"
      ],
      "fileSecurity": false,
      "enabled": true,
      "maximumFileSize": 10485760,
      "allowedFileExtensions": [
        "png",
        "jpg",
        "jpeg",
        "webp",
        "pdf",
        "txt",
        "md"
      ],
      "compression": "none",
      "encryption": true,
      "antivirus": false
    }
  ],
  "functions": [
    {
      "$id": "summarize",
      "name": "summarize",
      "runtime": "node-22",
      "path": "functions/summarize",
      "entrypoint": "src/main.js",
      "ignore": ["node_modules", ".env"],
      "execute": ["any"],
      "events": [],
      "schedule": "",
      "timeout": 60,
      "enabled": true,
      "logging": true
    }
  ]
}
